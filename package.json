{
  "name": "csjb-amap-collector",
  "version": "1.0.0",
  "private": true,
  "description": "北京休闲娱乐场所批量采集工具（高德地图采集 + 大众点评核验 + xlsx 导出）",
  "type": "commonjs",
  "main": "tools/collect.js",
  "scripts": {
    "collect": "node tools/collect.js",
    "browser": "node tools/start-browser.js",
    "login": "node tools/login.js",
    "check-login": "node tools/check-login.js",
    "close-browser": "node tools/close-browser.js",
    "web": "node web/server.js",
